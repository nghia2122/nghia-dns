<dict>
	<key>PayloadDisplayName</key>
	<string>NGHIA DNS PRO</string>
	<key>PayloadDescription</key>
	<string>NGHIA DNS PRO profile. Uses the Cloudflare Gateway DNS-over-HTTPS endpoint from the supplied original profile; that Gateway endpoint is operated by its owner.</string>
	<key>PayloadIdentifier</key>
	<string>vn.nghia.dnspro.profile</string>
	<key>PayloadScope</key>
	<string>System</string>
	<key>PayloadType</key>
	<string>Configuration</string>
